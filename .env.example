# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, local...)
# On serverless hosts use the *pooled* connection string.
DATABASE_URL=postgresql://trnfit:trnfit@localhost:5432/trnfit

# Initial access code for the first admin employee. Only read by `npm run db:seed`
# on the server. It is hashed (scrypt) before being stored; never shipped to the browser.
INITIAL_ACCESS_CODE=trnfit19

# Optional
# SESSION_TTL_HOURS=12          # session lifetime (sliding), default 12
# DATABASE_POOL_MAX=5           # max pg connections per server instance, default 5
# DATABASE_SSL=require          # set to "require" if your provider needs SSL and the URL lacks sslmode